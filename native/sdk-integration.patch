+/// The finite tool proof consumes the exact normally imported canonical bytes,
+/// not only the analytic plane on which the selected source happens to lie.
+#[test]
+fn mesh_finite_rectangle_recipe_survives_canonical_reload_and_rejects_wrong_extent() {
+    use solidcore::eval::Frame;
+    use solidcore::math::{Vec2, Vec3};
+    use solidcore::mesh_reconstruction as mesh;
+    use solidcore::prism::profile::{Loop2, Region2, Seg2};
+    let corners = [
+        Vec2::new(0., 0.),
+        Vec2::new(20., 0.),
+        Vec2::new(20., 10.),
+        Vec2::new(0., 10.),
+    ];
+    let tool = mesh::FittedTool {
+        surface: mesh::Primitive::Plane {
+            point: Vec3::ZERO,
+            normal: Vec3::Z,
+        },
+        geometry: mesh::ToolGeometry::Prism(mesh::PrismTool {
+            frame: Frame {
+                origin: [0.; 3],
+                x_axis: [1., 0., 0.],
+                y_axis: [0., 1., 0.],
+            },
+            regions: vec![Region2 {
+                outer: Loop2 {
+                    segs: corners
+                        .iter()
+                        .copied()
+                        .zip(corners.iter().copied().cycle().skip(1))
+                        .take(4)
+                        .map(|(a, b)| Seg2::Line { a, b })
+                        .collect(),
+                },
+                holes: Vec::new(),
+            }],
+            start: -3.,
+            end: 0.,
+        }),
+        source_triangles: vec![0, 1],
+        concave: false,
+    };
+    let source = mesh::MeshInput {
+        positions: vec![[2., 2., 0.], [18., 2., 0.], [18., 8., 0.], [2., 8., 0.]],
+        triangles: vec![[0, 1, 2], [0, 2, 3]],
+    };
+    let raw_positions = source.positions.clone();
+    let raw_triangles = source.triangles.clone();
+    let save = |geometry: &mesh::ToolGeometry| {
+        let candidate = run("mesh::finite_canonical_build", |k| {
+            let body = mesh::build_tool(k, geometry).unwrap();
+            Ok(Some(finish(k, body, Expect::SOLID)?.unwrap()))
+        })
+        .unwrap()
+        .unwrap();
+        let (record, _) = Body::new(candidate).to_record().unwrap();
+        serde_json::to_vec(&record).unwrap()
+    };
+    // Export and normal import precede proof. No export or replacement follows it.
+    let stored = save(&tool.geometry);
+    let work = mesh::MeshWork::new();
+    let mut bounds = Vec::new();
+    for _ in 0..2 {
+        let record = serde_json::from_slice(&stored).unwrap();
+        let (actual, _) = Body::from_record(&record, true).unwrap();
+        let bound = with_body("mesh::finite_canonical_final", &actual, |k, body| {
+            let proof =
+                mesh::certify_finite_fitted_tool_with_work(k, &work, &source, &tool, body, 0.05)
+                    .unwrap();
+            assert!(std::ptr::eq(proof.source().0, &source));
+            assert!(std::ptr::eq(proof.source().1, &tool));
+            let bounds = (proof.selected_finite_upper(), proof.recipe_boundary_upper());
+            assert!(bounds.0.is_finite() && bounds.0 <= 0.05);
+            assert!(bounds.1.is_finite() && bounds.1 <= 0.05);
+            Ok(Some((bounds.0.to_bits(), bounds.1.to_bits())))
+        })
+        .unwrap()
+        .unwrap();
+        bounds.push(bound);
+        assert_eq!(actual.counts().unwrap()[0], 6);
+        assert_eq!(serde_json::to_vec(&record).unwrap(), stored);
+    }
+    assert_eq!(bounds[0], bounds[1]);
+    // A second canonical body has the same plane but the wrong requested depth.
+    // The limited support claim can hold while the complete finite claim fails.
+    let mut wrong = tool.geometry.clone();
+    let mesh::ToolGeometry::Prism(prism) = &mut wrong else {
+        panic!("rectangle recipe")
+    };
+    prism.start = -0.1;
+    let wrong_stored = save(&wrong);
+    let wrong_record = serde_json::from_slice(&wrong_stored).unwrap();
+    let (wrong_actual, _) = Body::from_record(&wrong_record, true).unwrap();
+    let refused = with_body(
+        "mesh::finite_canonical_wrong_extent",
+        &wrong_actual,
+        |k, body| {
+            {
+                let support =
+                    mesh::certify_fitted_tool_with_work(k, &work, &source, &tool, body, 0.05)
+                        .unwrap();
+                assert!(support.upper_bound() <= 0.05);
+            }
+            Ok(Some(
+                mesh::certify_finite_fitted_tool_with_work(k, &work, &source, &tool, body, 0.05)
+                    .is_err(),
+            ))
+        },
+    )
+    .unwrap()
+    .unwrap();
+    assert!(
+        refused,
+        "the same infinite plane cannot authorize a different finite tool"
+    );
+    assert_eq!(source.positions, raw_positions);
+    assert_eq!(source.triangles, raw_triangles);
+    assert_eq!(serde_json::to_vec(&wrong_record).unwrap(), wrong_stored);
+}
