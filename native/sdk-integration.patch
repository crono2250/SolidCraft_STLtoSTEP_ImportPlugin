+#[test]
+fn fitted_native_cone_keeps_exact_source_pole_through_record_and_cache_free_reload() {
+    use solidcore::math::Vec3;
+    use solidcore::mesh_reconstruction as mesh;
+    use solidcore::surface::implicit::AnalyticSupport;
+    let n = 128u32;
+    let depth = 4. / 59f64.to_radians().tan();
+    let pole = Vec3::new(12.007, 15.007, 8. - depth);
+    let mut input = mesh::MeshInput {
+        positions: vec![pole.to_array()],
+        triangles: Vec::new(),
+    };
+    for i in 0..n {
+        let theta = std::f64::consts::TAU * f64::from(i) / f64::from(n);
+        input
+            .positions
+            .push((pole + Vec3::new(4. * theta.cos(), 4. * theta.sin(), depth)).to_array());
+        input.triangles.push([0, i + 1, (i + 1) % n + 1]);
+    }
+    let work = mesh::MeshWork::new();
+    let tools = run("mesh::cone_pole_fit", |k| {
+        Ok(Some(
+            mesh::fit_tools_with_work(
+                k,
+                &work,
+                &input,
+                0.02,
+                &[mesh::MeshPick {
+                    point: [13.507, 15.007, 7.4],
+                    kind: mesh::SurfaceKind::Cone,
+                }],
+                false,
+                0.01,
+            )
+            .unwrap(),
+        ))
+    })
+    .unwrap()
+    .unwrap();
+    assert_eq!(tools.len(), 1);
+    let selected = &tools[0];
+    let candidate = run("mesh::cone_pole_build", |k| {
+        let body = mesh::build_tool(k, &selected.geometry).unwrap();
+        Ok(Some(finish(k, body, Expect::SOLID)?.unwrap()))
+    })
+    .unwrap()
+    .unwrap();
+    let candidate = Body::new(candidate);
+    let (record, _) = candidate.to_record().unwrap();
+    let stored = serde_json::to_vec(&record).unwrap();
+    let mut bounds = Vec::new();
+    for _ in 0..2 {
+        let reloaded = serde_json::from_slice(&stored).unwrap();
+        let (imported, _) = Body::from_record(&reloaded, true).unwrap();
+        let bound = with_body("mesh::cone_pole_actual_proof", &imported, |k, body| {
+            let mut cones = 0;
+            for &face in body.face_list() {
+                if let Some(AnalyticSupport::Cone {
+                    placement,
+                    base_radius,
+                    ..
+                }) = body
+                    .face(face)
+                    .unwrap()
+                    .surface
+                    .as_ref()
+                    .and_then(AnalyticSupport::of)
+                {
+                    assert_eq!(placement.origin(), pole);
+                    assert_eq!(base_radius, 0.);
+                    cones += 1;
+                }
+            }
+            assert!(
+                cones > 0,
+                "the stored actual surface must keep the exact native cone pole"
+            );
+            let proof = mesh::certify_fitted_tool_with_work(k, &work, &input, selected, body, 0.02)
+                .unwrap();
+            Ok(Some(proof.upper_bound()))
+        })
+        .unwrap()
+        .unwrap();
+        assert!(bound.is_finite() && bound <= 0.02);
+        bounds.push(bound.to_bits());
+        assert_eq!(serde_json::to_vec(&record).unwrap(), stored);
+        // No export or geometry replacement occurs after the actual proof.
+    }
+    assert_eq!(bounds[0], bounds[1]);
+}
