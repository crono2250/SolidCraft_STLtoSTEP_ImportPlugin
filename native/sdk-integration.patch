+#[test]
+fn recorded_provenance_import_keeps_cold_record_indices_without_reexport() {
+    use crate::boolean::{boolean, BooleanOp};
+    use provenance::Cell;
+    use solidcore_record::brep::envelope;
+    use solidcore_record::native::{self, Runtime, Saved};
+    all_fixes();
+    // Two distinct, disjoint solids give a nontrivial region/shell/face walk. The public
+    // record part extractor puts the second material region first and renumbers all references.
+    let a = make_box([2.0, 3.0, 5.0], [1.0, 2.0, 3.0]).unwrap();
+    let b = make_box([13.0, 17.0, 19.0], [2.0, 3.0, 5.0]).unwrap();
+    let union = boolean(a, b, BooleanOp::Union).unwrap().unwrap();
+    let (record, _) = union.to_record().unwrap();
+    let regions = record.material_regions();
+    assert_eq!(regions.len(), 2);
+    let reordered = record.part(&[regions[1], regions[0]]).unwrap();
+    assert_ne!(
+        reordered.faces,
+        (0..record.faces.len() as u32).collect::<Vec<_>>()
+    );
+    assert_ne!(
+        reordered.edges,
+        (0..record.edges.len() as u32).collect::<Vec<_>>()
+    );
+    let stored = Saved {
+        solid: reordered.brep,
+        metadata: envelope::Metadata {
+            version: envelope::VERSION,
+            color: Some([0.25, 0.5, 0.75]),
+            paint: None,
+            boundaries: None,
+            face_sources: None,
+            history: None,
+            preserve_boundaries: false,
+        },
+        runtime: Runtime {
+            size: 31.0,
+            coarse_missing: None,
+        },
+    };
+    let bytes = native::encode(&stored).unwrap();
+    let cold = native::decode(&bytes).unwrap();
+    assert_eq!(native::encode(&cold).unwrap(), bytes);
+    let body = provenance::RecordedBody::from_record(&cold.solid).unwrap();
+    assert_eq!(body.record(), &stored.solid);
+    assert_eq!(body.record(), &cold.solid);
+    assert!(body
+        .provenance::<Origin>()
+        .unwrap()
+        .faces
+        .iter()
+        .all(Option::is_none));
+    let values: Vec<_> = (0..cold.solid.faces.len())
+        .map(|face| (Cell::Face(face), Origin(vec![face])))
+        .chain((0..cold.solid.edges.len()).map(|edge| (Cell::Edge(edge), Origin(vec![100 + edge]))))
+        .collect();
+    body.set_provenance(&values).unwrap();
+    let expected = provenance::Values {
+        faces: (0..cold.solid.faces.len())
+            .map(|face| Some(Origin(vec![face])))
+            .collect(),
+        edges: (0..cold.solid.edges.len())
+            .map(|edge| Some(Origin(vec![100 + edge])))
+            .collect(),
+    };
+    assert_eq!(body.provenance::<Origin>().unwrap(), expected);
+    assert_eq!(
+        body.record(),
+        &cold.solid,
+        "tagging never regenerates the stored record/order"
+    );
+    assert_eq!(
+        native::encode(&cold).unwrap(),
+        bytes,
+        "caller-owned metadata/runtime remain exact"
+    );
+    // A new canonical export is performed only after explicitly consuming the capability.
+    // Its face/edge geometry must still carry the input record indices, independent of IDs.
+    let working = body.into_body();
+    let (exported, order) = working.to_record().unwrap();
+    let native = working.lock();
+    for (face, &entity) in exported.faces.iter().zip(&order.faces) {
+        let source = cold
+            .solid
+            .faces
+            .iter()
+            .position(|f| f.surface == face.surface)
+            .unwrap();
+        assert_eq!(
+            provenance::read::<Origin>(&native, EntityRef::Face(entity)),
+            Some(Origin(vec![source]))
+        );
+    }
+    for (edge, &entity) in exported.edges.iter().zip(&order.edges) {
+        let source = cold
+            .solid
+            .edges
+            .iter()
+            .position(|e| e.curve == edge.curve && e.interval == edge.interval)
+            .unwrap();
+        assert_eq!(
+            provenance::read::<Origin>(&native, EntityRef::Edge(entity)),
+            Some(Origin(vec![100 + source]))
+        );
+    }
+}
