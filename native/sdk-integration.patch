+/// Input/certificate refusals remain typed. The one real workflow ledger is
+/// checked before malformed geometry, and cancellation precedes even that ledger.
+#[test]
+fn mesh_single_product_refusals_keep_source_and_budget_cancel_precedence() {
+    use crate::mesh::{
+        reconstruct_single_product, reconstruct_single_product_with_work, Error as MeshError,
+    };
+    use solidcore::mesh_reconstruction::{
+        MeshError as NativeError, MeshWork, ReconstructionRefusal, SourceTopologyRefusal,
+    };
+    all_fixes();
+    let input = mesh_recognition_original_with_leading_degenerate();
+    let mut invalid = input.clone();
+    invalid.triangles[1][1] = u32::MAX;
+    let source = invalid.clone();
+    assert!(matches!(
+        reconstruct_single_product((&invalid).into(), 0.05),
+        Err(MeshError::Geometry(error)) if matches!(error.0, NativeError::InvalidInput { .. })
+    ));
+    assert_eq!(invalid, source);
+    // A discarded collinear facet extends beyond the body, so its full convex
+    // hull is not redundant. Vertex fitting is not authority to delete it.
+    let mut outside = input.clone();
+    outside.positions[8].x = 100.0;
+    assert!(matches!(
+        reconstruct_single_product((&outside).into(), 0.05),
+        Err(MeshError::Certificate(error)) if matches!(error.0,
+            ReconstructionRefusal::SourceTopology {
+                reason: SourceTopologyRefusal::DegenerateTriangle { triangle: 0 }
+            })
+    ));
+    let work = MeshWork::new();
+    run("mesh::single_product_test_fill_ledger", |k| {
+        for _ in 0..20 {
+            let vertices = 100_000;
+            solidcore::mesh_reconstruction::admit_input_counts_with_work(
+                k,
+                &work,
+                solidcore::mesh_reconstruction::InputPurpose::Conversion,
+                vertices,
+                0,
+            )
+            .unwrap();
+        }
+        Ok(())
+    })
+    .unwrap();
+    assert!(matches!(
+        reconstruct_single_product_with_work(&work, (&invalid).into(), f64::NAN),
+        Err(MeshError::Geometry(error)) if matches!(error.0, NativeError::BudgetExceeded { .. })
+    ));
+    let token = crate::cancel::CancelToken::new();
+    token.cancel();
+    let result = crate::cancel::within(&token, || {
+        reconstruct_single_product_with_work(&work, (&invalid).into(), f64::NAN)
+    });
+    assert!(matches!(
+        result,
+        Err(MeshError::Operation(Error::Cancelled))
+    ));
+    assert_eq!(invalid, source);
+}
