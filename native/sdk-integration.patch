+#[test]
+fn recorded_provenance_sets_reads_and_replaces_in_record_order() {
+    use provenance::Cell;
+    all_fixes();
+    let body = recorded_origin_fixture(make_box([0.0; 3], [1.0; 3]).unwrap(), 0);
+    let record = body.record().clone();
+    let mut expected = provenance::Values {
+        faces: (0..6).map(|i| Some(Origin(vec![i]))).collect(),
+        edges: (0..12).map(|i| Some(Origin(vec![100 + i]))).collect(),
+    };
+    assert_eq!(body.provenance::<Origin>().unwrap(), expected);
+    assert!(body.edge_aliases().is_empty());
+    body.set_provenance(&[
+        (Cell::Face(2), Origin(vec![700])),
+        (Cell::Edge(3), Origin(vec![800])),
+        (Cell::Face(2), Origin(vec![700])),
+    ])
+    .unwrap();
+    expected.faces[2] = Some(Origin(vec![700]));
+    expected.edges[3] = Some(Origin(vec![800]));
+    assert_eq!(body.provenance::<Origin>().unwrap(), expected);
+    assert_eq!(body.record(), &record);
+    let body = body.into_body();
+    assert_eq!(body.counts().unwrap(), [6, 12, 8]);
+    assert!((body.volume(1e-9).unwrap() - 1.0).abs() <= 1e-9);
+}
