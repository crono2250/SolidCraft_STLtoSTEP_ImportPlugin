+impl<O: Copy + PartialEq> SurfaceCache<O> {
+    /// Read all retained owned buffers. No evaluation, clone or cache generation.
+    pub(crate) fn visit_stored_payload<'a>(
+        &'a self,
+        charge: &mut impl FnMut(usize) -> Result<()>,
+        geometry: &mut impl FnMut(StoredCacheGeometry<'a>) -> Result<()>,
+    ) -> Result<()> {
+        let Self {
+            trimmed_dispatch: _,
+            trimmed_face: _,
+            trimmed_face_key: _,
+            alt_caches,
+            tree,
+            surface,
+            surface_handle: _,
+            uv_domain: _,
+            u_continuities,
+            v_continuities,
+            patches,
+            auxs,
+            opts: _,
+            iso_curve_tolerance: _,
+            tessellation_algorithm: _,
+            start_fast_subdivision_angle_deg: _,
+            switch_to_fast_subdivision: _,
+            trim_subdivision_factor: _,
+            iso_boundary_curves,
+            subdivision_surfaces,
+            subdivision_handles: _,
+            subdivision_handle_count: _,
+            bounding_planes: _,
+            have_t_surface_cache: _,
+            face_was_modified: _,
+            process_boundary_curves: _,
+            point_test_enabled: _,
+            face_containment_done: _,
+            pole_memo,
+        } = self;
+        charge(1)?;
+        for size in [
+            alt_caches.capacity(),
+            u_continuities.capacity(),
+            v_continuities.capacity(),
+            patches.capacity(),
+            auxs.capacity(),
+            subdivision_surfaces.capacity(),
+        ] {
+            charge(size)?;
+        }
+        if pole_memo.is_some() {
+            return Err(SolidError::Unsupported {
+                operation: "surface_cache::visit_stored_payload",
+                reason: "active pole-subdivision memo is not a completed cache",
+            });
+        }
+        if let Some(tree) = tree {
+            tree.visit_stored_surface_payload(charge)?;
+        }
+        geometry(StoredCacheGeometry::Surface(surface))?;
+        for alternate in alt_caches {
+            let AltSrfCache {
+                cache_type: _,
+                approx_tol: _,
+                angle_tol: _,
+                user_vec: _,
+                user_bool: _,
+                user_long: _,
+                user_double: _,
+                user_pointer: _,
+                cached_3d_curves,
+                cached_uv_curves,
+            } = alternate;
+            for curves in [cached_3d_curves, cached_uv_curves].into_iter().flatten() {
+                charge(curves.capacity())?;
+                for curve in curves {
+                    geometry(StoredCacheGeometry::Curve(curve))?;
+                }
+            }
+        }
+        for patch in patches {
+            let BezierPatch {
+                aux,
+                bezier,
+                u_curve_conts: _,
+                v_curve_conts: _,
+                pseudo_box: _,
+            } = patch;
+            aux.visit_stored_payload(charge)?;
+            if let Some(nurb) = bezier {
+                geometry(StoredCacheGeometry::SurfaceNurb(nurb))?;
+            }
+        }
+        for aux in auxs {
+            aux.visit_stored_payload(charge)?;
+        }
+        if let Some(curves) = iso_boundary_curves {
+            charge(curves.len())?;
+            for curve in curves {
+                geometry(StoredCacheGeometry::Curve(curve))?;
+            }
+        }
+        for (_, surface) in subdivision_surfaces {
+            geometry(StoredCacheGeometry::Surface(surface))?;
+        }
+        Ok(())
+    }
