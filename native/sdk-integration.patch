+#[test]
+fn recorded_provenance_accepts_equal_and_aggregated_edge_alias_values_atomically() {
+    use crate::boolean::{boolean, BooleanOp};
+    use provenance::Cell;
+    all_fixes();
+    // Existing convert fixture: two unit solids touch along their one vertical edge.
+    let a = make_box([0.0; 3], [1.0; 3]).unwrap();
+    let b = make_box([1.0, 1.0, 0.0], [1.0; 3]).unwrap();
+    let body = boolean(a, b, BooleanOp::Union)
+        .unwrap()
+        .unwrap()
+        .into_recorded()
+        .unwrap();
+    let aliases = body.edge_aliases();
+    assert_eq!(aliases.len(), 1);
+    assert_eq!(aliases[0].len(), 2);
+    assert!(aliases[0].windows(2).all(|pair| pair[0] < pair[1]));
+    let (first, second) = (aliases[0][0], aliases[0][1]);
+    let record = body.record().clone();
+    let before = body.provenance::<Origin>().unwrap();
+    assert!(before.faces.iter().all(Option::is_none));
+    assert!(before.edges.iter().all(Option::is_none));
+    assert_eq!(
+        body.set_provenance(&[
+            (Cell::Face(0), Origin(vec![99])),
+            (Cell::Edge(first), Origin(vec![7])),
+            (Cell::Edge(second), Origin(vec![8])),
+        ]),
+        Err(Error::Argument)
+    );
+    assert_eq!(body.provenance::<Origin>().unwrap(), before);
+    assert_eq!(body.record(), &record);
+    body.set_provenance(&[
+        (Cell::Edge(first), Origin(vec![7])),
+        (Cell::Edge(second), Origin(vec![7])),
+        (Cell::Edge(first), Origin(vec![7])),
+    ])
+    .unwrap();
+    let same = body.provenance::<Origin>().unwrap();
+    assert_eq!(same.edges[first], Some(Origin(vec![7])));
+    assert_eq!(same.edges[second], Some(Origin(vec![7])));
+    assert_eq!(same.faces, before.faces);
+    // Aggregation belongs to the application; ops writes exactly its supplied joined value.
+    let aggregate = Origin(vec![7]).joined(&Origin(vec![8]));
+    body.set_provenance(&[
+        (Cell::Edge(first), aggregate.clone()),
+        (Cell::Edge(second), aggregate.clone()),
+    ])
+    .unwrap();
+    let joined = body.provenance::<Origin>().unwrap();
+    assert_eq!(joined.edges[first], Some(aggregate.clone()));
+    assert_eq!(joined.edges[second], Some(aggregate));
+    assert_eq!(body.record(), &record);
+    assert_eq!(body.edge_aliases(), aliases);
+}
