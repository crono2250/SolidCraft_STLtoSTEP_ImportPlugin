+#[test]
+fn recorded_provenance_carries_origins_through_boolean_split_merge_and_coincidence() {
+    use crate::boolean::{boolean, BooleanOp};
+    all_fixes();
+    let a = recorded_origin_fixture(make_box([0.0; 3], [3.0; 3]).unwrap(), 0);
+    let slab = make_box([-1.0, -1.0, 1.0], [5.0, 5.0, 1.0]).unwrap();
+    let split = boolean(a.into_body(), slab, BooleanOp::Subtract)
+        .unwrap()
+        .unwrap()
+        .into_recorded()
+        .unwrap();
+    let seen = split.provenance::<Origin>().unwrap();
+    assert_eq!(seen.faces.len(), 12);
+    assert_eq!(seen.faces.iter().filter(|o| o.is_none()).count(), 2);
+    let mut counts = [0usize; 6];
+    for value in seen.faces.iter().flatten() {
+        assert_eq!(value.0.len(), 1);
+        counts[value.0[0]] += 1;
+    }
+    counts.sort_unstable();
+    assert_eq!(counts, [1, 1, 2, 2, 2, 2]);
+
+    let both = |value: &Origin, offset: usize| {
+        value.0.len() == 2
+            && value.0.iter().any(|i| (offset..offset + 100).contains(i))
+            && value
+                .0
+                .iter()
+                .any(|i| (1000 + offset..1100 + offset).contains(i))
+    };
+    let a = recorded_origin_fixture(make_box([0.0; 3], [1.0; 3]).unwrap(), 0);
+    let b = recorded_origin_fixture(make_box([1.0, 0.0, 0.0], [1.0; 3]).unwrap(), 1000);
+    let merged = boolean(a.into_body(), b.into_body(), BooleanOp::Union)
+        .unwrap()
+        .unwrap()
+        .into_recorded()
+        .unwrap();
+    let values = merged.provenance::<Origin>().unwrap();
+    assert_eq!((values.faces.len(), values.edges.len()), (6, 12));
+    assert!(
+        values.faces.iter().flatten().any(|v| both(v, 0)),
+        "{values:?}"
+    );
+    assert!(
+        values.edges.iter().flatten().any(|v| both(v, 100)),
+        "{values:?}"
+    );
+
+    let a = recorded_origin_fixture(make_box([0.0; 3], [1.0; 3]).unwrap(), 0);
+    let b = recorded_origin_fixture(make_box([0.0; 3], [1.0; 3]).unwrap(), 1000);
+    let coincident = boolean(a.into_body(), b.into_body(), BooleanOp::Union)
+        .unwrap()
+        .unwrap()
+        .into_recorded()
+        .unwrap();
+    let values = coincident.provenance::<Origin>().unwrap();
+    assert_eq!((values.faces.len(), values.edges.len()), (6, 12));
+    assert!(
+        values
+            .faces
+            .iter()
+            .all(|v| v.as_ref().is_some_and(|v| both(v, 0))),
+        "{values:?}"
+    );
+    assert!(
+        values
+            .edges
+            .iter()
+            .all(|v| v.as_ref().is_some_and(|v| both(v, 100))),
+        "{values:?}"
+    );
+}
