+/// Notify an actual coincident mate once, rather than Copy onto an existing attribute ID.
+/// The caller has already related the objects; no geometry is matched here.
+pub(crate) fn notify_coincident_copy(
+    copy: &mut VertexCopy<'_>,
+    context: Option<&mut Context>,
+    source: ObjectRef,
+    survivor: ObjectRef,
+    relations: &mut Relations,
+) -> Result<()> {
+    let pair = (source.key, survivor.key);
+    if relations.coincident_copies.contains(&pair) {
+        return Ok(());
+    }
+    copy.records.or_default(source.key);
+    copy.records.or_default(survivor.key);
+    topo::notify(
+        copy.records,
+        copy.attributes,
+        context,
+        NotifyOperation::Coincident,
+        source,
+        Some(survivor),
