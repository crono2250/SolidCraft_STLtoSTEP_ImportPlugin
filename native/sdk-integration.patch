+    let mut input = MeshInput {
+        positions: Vec::new(),
+        triangles: Vec::new(),
+    };
+    for z in [0.0, 5.0] {
+        for i in 0..n {
+            let angle = std::f64::consts::TAU * f64::from(i) / f64::from(n);
+            input
+                .positions
+                .push(Vec3::new(2.0 * angle.cos(), 2.0 * angle.sin(), z));
+        }
+    }
+    input
+        .positions
+        .extend([Vec3::new(0.0, 0.0, 0.0), Vec3::new(0.0, 0.0, 5.0)]);
+    for i in 0..n {
+        let next = (i + 1) % n;
+        input.triangles.extend([
+            [2 * n, next, i],
+            [2 * n + 1, n + i, n + next],
+            [i, next, n + next],
+            [i, n + next, n + i],
+        ]);
+    }
+    let source = input.clone();
+    let result = reconstruct_single_product((&input).into(), 0.05)
