+/// Visit the loop's native CCW edge-use walk WITHOUT allocating an id vector.
+/// The callback can poll cancellation/admit resources before materializing each
+/// id. True means the normal native stop (start OR null termination), not a proof
+/// of closed topology. False means the caller's bound was reached; discard the
+/// partial result. Vertex/unknown/empty loops preserve `edgeuses` semantics.
+///
+/// # Errors
+/// Native dangling/nonclosing-walk errors and the callback's original error are
+/// propagated unchanged. A refused callback is never followed by another visit.
+pub(crate) fn visit_edgeuses_bounded(
+    b: &Brep,
+    lu: LoopuseId,
+    limit: usize,
+    visit: impl FnMut(EdgeuseId) -> Result<()>,
+) -> Result<bool> {
+    let Walk::Edges(start) = walk_start(b, lu)? else {
+        return Ok(true);
+    };
+    ccw_visit(b, start, Some(limit), visit)
