+fn mesh_single_product_cylinder_keeps_analytic_surface_after_cold_reload() {
+    use crate::mesh::reconstruct_single_product;
+    use solidcore_record::brep::Surface;
+    use solidcore_record::mesh::MeshInput;
+    use solidcore_record::Vec3;
+    all_fixes();
