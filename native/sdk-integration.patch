+/// All tags are set through the public record-owned capability. The existing Origin rules
+/// join source IDs on a split, merge or coincidence; the caller, not ops, owns their meaning.
+fn recorded_origin_fixture(body: Body, base: usize) -> provenance::RecordedBody {
+    use provenance::Cell;
+    let body = body.into_recorded().unwrap();
+    let values: Vec<_> = (0..body.record().faces.len())
+        .map(|i| (Cell::Face(i), Origin(vec![base + i])))
+        .chain(
+            (0..body.record().edges.len()).map(|i| (Cell::Edge(i), Origin(vec![base + 100 + i]))),
+        )
+        .collect();
+    body.set_provenance(&values).unwrap();
+    body
+}
