+#[test]
+fn recorded_provenance_survives_copy_with_renumbered_entities() {
+    all_fixes();
+    let body = make_box([0.0; 3], [1.0; 3]).unwrap();
+    let (_, source_order) = body.to_record().unwrap();
+    let source = recorded_origin_fixture(body, 0);
+    let before = source.provenance::<Origin>().unwrap();
+    let body = source.into_body();
+    // The existing copy fixture changes native list order so copied IDs really differ.
+    {
+        let mut native = body.lock();
+        let faces = native.face_list().iter().rev().copied().collect();
+        native.set_face_list(faces).unwrap();
+        let edges = native.edge_list().iter().rev().copied().collect();
+        native.set_edge_list(edges).unwrap();
+        let vertices = native.vertex_list().iter().rev().copied().collect();
+        native.set_vertex_list(vertices).unwrap();
+    }
+    let (copy, mapped) = body.copy_with_order(&source_order).unwrap();
+    assert!(source_order
+        .faces
+        .iter()
+        .zip(&mapped.faces)
+        .any(|(a, b)| a != b));
+    assert!(source_order
+        .edges
+        .iter()
+        .zip(&mapped.edges)
+        .any(|(a, b)| a != b));
+    let (copy_record, copy_order) = copy.to_record().unwrap();
+    let expected = provenance::Values {
+        faces: copy_order
+            .faces
+            .iter()
+            .map(|id| {
+                before.faces[mapped.faces.iter().position(|from| from == id).unwrap()].clone()
+            })
+            .collect(),
+        edges: copy_order
+            .edges
+            .iter()
+            .map(|id| {
+                before.edges[mapped.edges.iter().position(|from| from == id).unwrap()].clone()
+            })
+            .collect(),
+    };
+    let copy = copy.into_recorded().unwrap();
+    assert_eq!(copy.record(), &copy_record);
+    assert_eq!(copy.provenance::<Origin>().unwrap(), expected);
+    assert_eq!(body.counts().unwrap(), [6, 12, 8]);
+    assert_eq!(copy.into_body().counts().unwrap(), [6, 12, 8]);
+}
