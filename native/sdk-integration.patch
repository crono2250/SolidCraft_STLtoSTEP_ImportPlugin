+    /// Visits all standard owned payload counts without copying the store.
+    ///
+    /// Slots include tombstones. Object-list map entries, each object list, each
+    /// attribute's users, and every standard dynamic value container are charged
+    /// before traversal. Counts describe initialized entries, not byte sizes or
+    /// spare capacity. No payload contents are scanned and no storage is changed.
+    ///
+    /// # Errors
+    ///
+    /// Propagates `charge` errors unchanged and stops before later containers.
+    /// Returns `Unsupported` for an opaque application value, without cloning it
+    /// or calling any of its handlers: its ownership has not been qualified.
+    pub(crate) fn visit_stored_payload(
+        &self,
+        charge: &mut impl FnMut(usize) -> Result<()>,
+    ) -> Result<()> {
+        charge(self.slots.len())?;
+        for attribute in self.slots.iter().flatten() {
+            charge(attribute.users.len())?;
+            match &attribute.value {
+                AttributeValue::Generic {
+                    longs,
+                    doubles,
+                    chars,
+                } => {
+                    charge(longs.len())?;
+                    charge(doubles.len())?;
+                    charge(chars.len())?;
+                }
+                AttributeValue::PointerList(values) => charge(values.len())?,
+                AttributeValue::MergeRegion(data) => {
+                    charge(data.this_regions.len())?;
+                    charge(data.this_types.len())?;
+                    charge(data.other_regions.len())?;
+                    charge(data.other_types.len())?;
+                }
+                AttributeValue::Application(_) => {
+                    return Err(SolidError::Unsupported {
+                        operation: "geom::attribute::AttributeStore::visit_stored_payload",
+                        reason: "application-defined attribute payload has no qualified inventory",
+                    });
+                }
+                // These standard variants contain only fixed inline data. Their
+                // storage is included in the already charged attribute slot.
+                AttributeValue::None
+                | AttributeValue::Long(_)
+                | AttributeValue::Pointer(_)
+                | AttributeValue::Vector3d(_)
+                | AttributeValue::Tag(_)
+                | AttributeValue::Color(_)
+                | AttributeValue::PolyToEuVu { .. }
+                | AttributeValue::PolyEdgeToVertexUse { .. }
+                | AttributeValue::DecimateVertex(_)
+                | AttributeValue::QuadricVertex(_)
+                | AttributeValue::QuadricEdge(_) => {}
+            }
+        }
+        charge(self.lists.len())?;
+        for list in self.lists.values() {
+            charge(list.len())?;
+        }
+        Ok(())
+    }
