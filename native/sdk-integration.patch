+/// Final source certification inspects the native body imported from the exact
+/// record retained by the application, including a fresh cache-free reload.
+/// No export occurs after either successful certificate.
+#[test]
+fn mesh_canonical_record_import_and_cache_free_reload_consume_the_same_source_proof() {
+    use solidcore::mesh_reconstruction as mesh;
+    all_fixes();
+    let input = mesh::MeshInput {
+        positions: vec![
+            [0., 0., 0.],
+            [20., 0., 0.],
+            [20., 10., 0.],
+            [0., 10., 0.],
+            [0., 0., 5.],
+            [20., 0., 5.],
+            [20., 10., 5.],
+            [0., 10., 5.],
+        ],
+        triangles: vec![
+            [0, 2, 1],
+            [0, 3, 2],
+            [4, 5, 6],
+            [4, 6, 7],
+            [0, 1, 5],
+            [0, 5, 4],
+            [1, 2, 6],
+            [1, 6, 5],
+            [2, 3, 7],
+            [2, 7, 6],
+            [3, 0, 4],
+            [3, 4, 7],
+        ],
+    };
+    let work = mesh::MeshWork::new();
+    let mut prepared = run("mesh::canonical_test_prepare", |k| {
+        Ok(Some(
+            mesh::prepare_conversion_with_work(k, &work, &input, 0.05, &[]).unwrap(),
+        ))
+    })
+    .unwrap()
+    .unwrap();
+    prepared.provenance.faceted_source_patches = run("mesh::canonical_test_plan", |k| {
+        let plan = mesh::faceted_plan_with_work(k, &work, &input, 0.05).unwrap();
+        Ok(Some(
+            plan.into_source_patch_claims_with_work(k, &work).unwrap(),
