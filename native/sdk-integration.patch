+/// A face or edge index in the canonical record held by a [`RecordedBody`].
+///
+/// This is an index, not a native entity ID. It names only the owner it is passed to; no order
+/// supplied by a caller is accepted. Two record edges can name one native edge; see
+/// [`RecordedBody::edge_aliases`].
+#[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord)]
+pub enum Cell {
+    /// An index in [`solidcore_record::brep::Brep::faces`].
+    Face(usize),
+    /// An index in [`solidcore_record::brep::Brep::edges`].
+    Edge(usize),
+}
+
+/// The application's data on each face and edge, in the owner's canonical record order.
+///
+/// An edge with several record entries appears once at each of those entries, with the same
+/// value. No history classification is inferred: the caller owns persistent construction
+/// history and any grouping of these values into it.
+#[derive(Clone, Debug, PartialEq)]
+pub struct Values<P> {
+    /// One value (or no value) per record face.
+    pub faces: Vec<Option<P>>,
+    /// One value (or no value) per record edge, including legitimate aliases.
+    pub edges: Vec<Option<P>>,
+}
+
+/// An owned body bound to the canonical record and order exported from that very body.
+///
+/// Only provenance attributes can be changed through this capability. It neither lends the
+/// body nor accepts another body's order. To edit geometry, consume it with [`Self::into_body`]
+/// and obtain a new capability afterwards. Cloning a record does not clone this ownership.
+///
+/// Provenance remains the native operation's carried application attribute. The record is
+/// geometry as data, not a serialization of arbitrary application attributes: the application
+/// owns their persistence and its neutral history. This capability does not infer generated,
+/// modified or surviving-face roles.
+#[derive(Debug)]
+pub struct RecordedBody {
+    body: crate::Body,
+    record: solidcore_record::brep::Brep,
+    order: crate::Order,
+}
+
+impl crate::Body {
+    /// Consume this body and bind provenance indices to its current canonical record.
+    ///
+    /// Record and native order are exported together under the existing body/session guard.
+    /// Keeping the body private then prevents a geometry edit from invalidating that order.
+    /// Export may prepare the body's trims, as [`Self::to_record`] does. On failure this consumed
+    /// operand is dropped; retain a copy before the call if the caller needs its own operand.
+    ///
+    /// # Errors
+    /// Those of [`Self::to_record`]; [`crate::Error::Record`] for an inconsistent export order.
+    pub fn into_recorded(self) -> crate::Result<RecordedBody> {
+        let (record, order) = self.to_record()?;
+        if record.faces.len() != order.faces.len()
+            || record.edges.len() != order.edges.len()
+            || record.vertices.len() != order.vertices.len()
+        {
+            return Err(crate::Error::Record(
+                "provenance export order does not match its record".into(),
+            ));
+        }
+        Ok(RecordedBody {
+            body: self,
+            record,
+            order,
+        })
+    }
+}
+
+impl RecordedBody {
+    /// Import this exact stored record and bind its indices to the body made from it.
+    ///
+    /// The body and order are returned together by the existing guarded importer. No caller's
+    /// order is accepted and no canonical re-export is performed: appearance, saved face names
+    /// and history held by the application can continue to index precisely this input record.
+    /// Healing is disabled to keep those identities; this is not a geometric/source certificate.
+    /// The record is cloned as data, with all of its stored fields and list order unchanged.
+    ///
+    /// # Errors
+    /// Those of [`crate::Body::from_record`]; [`crate::Error::Record`] for an inconsistent import
+    /// order. An import error produces no owner and does not change the caller's record.
+    pub fn from_record(record: &solidcore_record::brep::Brep) -> crate::Result<Self> {
+        let (body, order) = crate::Body::from_record(record, true)?;
+        if record.faces.len() != order.faces.len()
+            || record.edges.len() != order.edges.len()
+            || record.vertices.len() != order.vertices.len()
+        {
+            return Err(crate::Error::Record(
+                "provenance import order does not match its record".into(),
+            ));
+        }
+        Ok(Self {
+            body,
+            record: record.clone(),
+            order,
+        })
+    }
+
+    /// The immutable canonical record whose indices this owner accepts.
+    #[must_use]
+    pub fn record(&self) -> &solidcore_record::brep::Brep {
+        &self.record
+    }
+
+    /// Return the body for geometry edits, consuming this record/order capability.
+    #[must_use]
+    pub fn into_body(self) -> crate::Body {
+        self.body
+    }
+
+    fn entity(&self, cell: Cell) -> crate::Result<EntityRef> {
+        match cell {
+            Cell::Face(index) => self.order.faces.get(index).copied().map(EntityRef::Face),
+            Cell::Edge(index) => self.order.edges.get(index).copied().map(EntityRef::Edge),
+        }
+        .ok_or(crate::Error::Argument)
+    }
+
+    /// Groups of record edge indices naming the same native edge, each group of length >= 2.
+    ///
+    /// Members and groups are in increasing record-index order. These are exact aliases from
+    /// the canonical exporter, not coincident geometry guessed from coordinates. A caller that
+    /// has different origins for the entries can explicitly aggregate them using its own rules
+    /// before setting the one value the native edge carries.
+    #[must_use]
+    pub fn edge_aliases(&self) -> Vec<Vec<usize>> {
+        let mut by_edge = std::collections::BTreeMap::new();
+        for (index, &edge) in self.order.edges.iter().enumerate() {
+            by_edge.entry(edge).or_insert_with(Vec::new).push(index);
+        }
+        let mut groups: Vec<_> = by_edge.into_values().filter(|g| g.len() > 1).collect();
+        groups.sort_by_key(|g| g.first().copied());
+        groups
+    }
+
+    /// Replace this kind of provenance on the requested canonical faces and edges atomically.
+    ///
+    /// Every index, entity and duplicate assignment is checked before the first attribute is
+    /// changed. Equal values naming one entity (including record-edge aliases) are one write;
+    /// conflicting values are refused, never resolved by input order. Work is bounded by the
+    /// supplied slice and the owner's order: O(m log n) for m assignments and n distinct named
+    /// entities, with O(n) temporary storage; no pairwise scan or topology walk is needed.
+    ///
+    /// The existing body transaction restores attributes and geometry on a refusal, a kernel
+    /// error, cancellation or a caught panic. Only tags change on success, so the captured
+    /// canonical record/order remain current. Application equality and clone rules run within
+    /// that guard as well.
+    ///
+    /// # Errors
+    /// [`crate::Error::Argument`] for an out-of-range index, conflicting values on one entity,
+    /// or an ID taken by another provenance type; [`crate::Error::Record`] for an owner mapping
+    /// that no longer names a live entity; the guarded operation's kernel/cancellation error.
+    pub fn set_provenance<P: Provenance>(&self, values: &[(Cell, P)]) -> crate::Result<()> {
+        crate::session::with_body("provenance::set", &self.body, |_, body| {
+            Ok((|| -> crate::Result<()> {
+                take::<P>()?;
+                let mut planned = std::collections::BTreeMap::<EntityRef, &P>::new();
+                for (cell, value) in values {
+                    let entity = self.entity(*cell)?;
+                    if !body.is_live_entity(entity) {
+                        return Err(crate::Error::Record(format!(
+                            "provenance {cell:?} does not name a live owner entity"
+                        )));
+                    }
+                    if let Some(previous) = planned.get(&entity) {
+                        if *previous != value {
+                            return Err(crate::Error::Argument);
+                        }
+                    } else {
+                        planned.insert(entity, value);
+                    }
+                }
+                for (entity, value) in planned {
+                    attach(body, entity, value.clone())?;
+                }
+                Ok(())
+            })())
+        })?
+    }
+
+    /// Read this kind of provenance in this owner's canonical face and edge order.
+    ///
+    /// The type takes its ID on reads too: an incompatible type never looks like missing data.
+    /// Application data is cloned under the existing immutable native guard. Alias entries read
+    /// the same entity; [`Self::edge_aliases`] explains their relationship without inventing
+    /// application history.
+    ///
+    /// # Errors
+    /// [`crate::Error::Argument`] for an ID taken by another provenance type;
+    /// [`crate::Error::Record`] for an owner mapping that no longer names a live entity;
+    /// the guarded operation's kernel/cancellation error.
+    pub fn provenance<P: Provenance>(&self) -> crate::Result<Values<P>> {
+        crate::session::read_body("provenance::read", &self.body, |_, body| {
+            Ok((|| -> crate::Result<Values<P>> {
+                take::<P>()?;
+                let mut faces = Vec::new();
+                let mut edges = Vec::new();
+                for &face in &self.order.faces {
+                    let entity = EntityRef::Face(face);
+                    if !body.is_live_entity(entity) {
+                        return Err(crate::Error::Record(
+                            "provenance face order does not name a live owner entity".into(),
+                        ));
+                    }
+                    faces.push(read::<P>(body, entity));
+                }
+                for &edge in &self.order.edges {
+                    let entity = EntityRef::Edge(edge);
+                    if !body.is_live_entity(entity) {
+                        return Err(crate::Error::Record(
+                            "provenance edge order does not name a live owner entity".into(),
+                        ));
+                    }
+                    edges.push(read::<P>(body, entity));
+                }
+                Ok(Values { faces, edges })
+            })())
+        })?
+    }
+}
