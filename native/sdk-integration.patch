+/// Carry a point through an affine map, using the kernel's existing point transform.
+///
+/// # Errors
+/// [`Error::Argument`] for a non-affine map, non-finite input or non-finite result.
+pub fn transform_point(matrix: &Matrix, point: [f64; 3]) -> Result<[f64; 3]> {
+    if !finite(matrix.as_flattened()) || !finite(&point) {
+        return Err(Error::Argument);
+    }
+    let [[_, _, _, a], [_, _, _, b], [_, _, _, c], [_, _, _, d]] = *matrix;
+    if [a, b, c, d] != [0., 0., 0., 1.] {
+        return Err(Error::Argument);
+    }
+    let point = Transform { m: *matrix }.transform_point(vec3(point));
+    let point = [point.x, point.y, point.z];
+    if !finite(&point) {
+        return Err(Error::Argument);
+    }
+    Ok(point)
+}
